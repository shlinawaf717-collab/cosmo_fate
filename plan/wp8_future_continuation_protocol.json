  },
  "secondary": {
    "full_cmb_crosscheck_only_after_primary_freeze": true,
    "requires_validated_wp7_full_cmb_posterior": true,
    "absence_invalidates_primary": false
  },
  "out_of_scope": [
    "family-averaged fate probabilities without prospectively justified family weights",
